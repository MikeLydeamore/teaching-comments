TEACHER_PIN=replace-with-a-private-pin-before-deploying
ADMIN_PIN=replace-with-a-private-admin-pin-before-deploying
TEACHER_AUTH_SECRET=replace-with-a-random-cookie-secret-before-deploying

# Optional. This is a browser-exposed public key for student GIF search.
NEXT_PUBLIC_GIPHY_API_KEY=

# local keeps using .data/qwt-store.json. Explicitly choose local, supabase, or neon.
QWT_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only pooled connection URL for the Neon qwt_app role. Never use NEXT_PUBLIC_.
DATABASE_URL=

# Private student image uploads. Keep all values server-side.
IMAGE_UPLOADS_ENABLED=false
IMAGE_WORKER_URL=
IMAGE_WORKER_SERVICE_TOKEN=replace-with-a-32-character-or-longer-random-service-token
IMAGE_TICKET_SECRET=replace-with-a-32-character-or-longer-random-secret
