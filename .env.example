# Better Auth. Social login only — no passwords, so no reset flows.
BETTER_AUTH_SECRET=replace-with-a-random-32-char-or-longer-secret
# Local: http://localhost:3000. Production: your deployed origin.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "organizations" for any work/school tenant, or a tenant GUID for one organisation.
MICROSOFT_TENANT_ID=organizations
# Optional Postgres override for Better Auth tables. Falls back to DATABASE_URL.
# Local dev uses a separate Docker database.
AUTH_DATABASE_URL=postgres://edie:edie@localhost:5432/edie_auth
# Comma-separated allow-list of verified emails that may use /admin/spaces.
ADMIN_EMAILS=
# Secures the daily Vercel purge for spaces deleted more than 30 days ago.
CRON_SECRET=replace-with-a-random-16-char-or-longer-secret

# Optional. This is a browser-exposed public key for student GIF search.
NEXT_PUBLIC_GIPHY_API_KEY=

# Keep local development data in .data/edie-store.json.
# In production, omit this setting and provide DATABASE_URL.
EDIE_STORAGE_BACKEND=local
# Server-only pooled PostgreSQL URL for the edie_app role. Never use NEXT_PUBLIC_.
DATABASE_URL=

# Edition and hosted Cloud quotas. Development/test defaults to Community;
# production deployments must select a mode explicitly. Cloud accepts a
# non-negative integer or "unlimited" for each quota.
EDIE_DEPLOYMENT_MODE=community
EDIE_CLOUD_FREE_CONCURRENT_PARTICIPANTS_LIMIT=30
EDIE_CLOUD_FREE_OWNED_SPACES_LIMIT=1
EDIE_CLOUD_FREE_TEACHER_SEATS_LIMIT=1
EDIE_CLOUD_PRO_CONCURRENT_PARTICIPANTS_LIMIT=unlimited
EDIE_CLOUD_PRO_OWNED_SPACES_LIMIT=10
EDIE_CLOUD_PRO_TEACHER_SEATS_LIMIT=5

# Optional Redis connection URL for realtime updates and presence.
# Without it, live submission views fall back to polling.
REDIS_URL=

# Private student image uploads. Keep all values server-side.
IMAGE_UPLOADS_ENABLED=false
IMAGE_WORKER_URL=
IMAGE_WORKER_SERVICE_TOKEN=replace-with-a-32-character-or-longer-random-service-token
IMAGE_TICKET_SECRET=replace-with-a-32-character-or-longer-random-secret
