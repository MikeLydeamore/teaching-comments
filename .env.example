# Better Auth. Social login only — no passwords, so no reset flows.
BETTER_AUTH_SECRET=replace-with-a-random-32-char-or-longer-secret
# Local: http://localhost:3000. Production: your deployed origin.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Postgres for accounts/sessions (Better Auth tables). Local dev uses Docker.
AUTH_DATABASE_URL=postgres://edie:edie@localhost:5432/edie_auth
# Comma-separated allow-list of verified emails that may use /admin/spaces.
ADMIN_EMAILS=

# Optional. This is a browser-exposed public key for student GIF search.
NEXT_PUBLIC_GIPHY_API_KEY=

# local keeps using .data/edie-store.json. Explicitly choose local or neon.
EDIE_STORAGE_BACKEND=local
# Server-only pooled connection URL for the Neon edie_app role. Never use NEXT_PUBLIC_.
DATABASE_URL=

# Private student image uploads. Keep all values server-side.
IMAGE_UPLOADS_ENABLED=false
IMAGE_WORKER_URL=
IMAGE_WORKER_SERVICE_TOKEN=replace-with-a-32-character-or-longer-random-service-token
IMAGE_TICKET_SECRET=replace-with-a-32-character-or-longer-random-secret
