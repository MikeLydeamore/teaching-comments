{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edie-image-storage",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-12",
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "edie-submission-images"
		},
		{
			"bucket_name": "edie-submission-images",
			"binding": "edie_submission_images",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "CLIENT_RATE",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "SESSION_RATE",
			"namespace_id": "1002",
			"simple": {
				"limit": 300,
				"period": 60
			}
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "http://localhost:3000,https://teaching-comments-xi.vercel.app,https://www.ed-ie.com,https://ed-ie.com,https://teaching-comments-git-neon-mikelydeamores-projects.vercel.app"
	}
}